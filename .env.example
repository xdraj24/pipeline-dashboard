# JIRA status column. Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@welligence.com
JIRA_API_TOKEN=
# JIRA_SITE=welligence.atlassian.net
# PORT=4848
# Web checkout the dashboard watches; defaults to ../web next to this folder.
# WEB_REPO_ROOT=/Users/you/coding/web
# JIRA project key of the watched repo's tickets (branches, plan folders, logs); defaults to XWWP.
# TICKET_PREFIX=XWWP
# Comma-separated JIRA statuses that, with the PR merged, archive a ticket.
# ARCHIVE_JIRA_STATUSES=QC'd on STG,Delivered IN APP.WELLIGENCE
# JIRA_SPRINT_JQL=project = XWWP AND sprint in openSprints() AND statusCategory != Done AND issuetype != Epic ORDER BY Rank ASC
